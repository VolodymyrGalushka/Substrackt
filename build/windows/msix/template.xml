<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="substrackt"
        Arguments=""
        InstallLocation="C:\Program Files\Substrackt\Substrackt">
    </Installer>
    <PackageInformation
        PackageName="Substrackt"
        PackageDisplayName="Substrackt"
        PublisherName="CN=Substrackt"
        PublisherDisplayName="Substrackt"
        Version="0.2.0.0"
        PackageDescription="Substrackt desktop app">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.substrackt.app"
                Description="Substrackt desktop app"
                DisplayName="Substrackt"
                ExecutableName="substrackt"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Substrackt</DisplayName>
            <PublisherDisplayName>Substrackt</PublisherDisplayName>
            <Description>Substrackt desktop app</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="substrackt.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
